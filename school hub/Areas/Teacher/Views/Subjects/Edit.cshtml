@model EditSubjectViewModel
@{
    ViewData["Title"] = "تعديل المادة";
}

<form asp-action="Edit" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SubjectId" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TotalDuration"></label>
        <input asp-for="TotalDuration" class="form-control" />
        <span asp-validation-for="TotalDuration" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>الصورة الحالية:</label><br />
        @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
        {
            <img src="@Model.ExistingImagePath" class="img-thumbnail" style="width:220px; height:200px" />
        }
    </div>

    <div class="form-group">
        <label asp-for="NewImage"></label>
        <input asp-for="NewImage" type="file" class="form-control" />
        <span asp-validation-for="NewImage" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">حفظ التعديلات</button>
</form>
