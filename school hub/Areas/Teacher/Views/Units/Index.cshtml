@model IEnumerable<Unit>
@{
    ViewData["Title"] = "قائمة الوحدات";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">قائمة الوحدات</h1>
    <a asp-action="Create" asp-controller="Units" asp-area="Teacher">اضافة وحدة جديدة</a>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>اسم الوحدة</th>
                <th>الوصف</th>
        </tr>
        </thead>
        <tbody>
            @foreach (var unit in Model)
            {
                <tr id="row-@unit.UnitId">
                    <td>@unit.Name</td>
                    <td>@unit.Description</td>
                    <td>
                        @if(!string.IsNullOrEmpty(unit.ImagePath)){
                            <img src="@unit.ImagePath" alt="صورة المادة" width="70px" height="70px" >
                        }
                    </td>
                    <td>
                         <a asp-action="Index" asp-controller="Lessons" asp-area="Teacher" asp-route-unitId="@unit.UnitId" class="btn btn-sm btn-secondary" style="text-decoration: none;">عرض الدروس</a>
                        <button class="btn btn-sm btn-danger"
                                onclick="showConfirmDialog({
                                    url: '/Teacher/Units/DeleteConfirmed/@unit.UnitId',
                                    rowSelector: '#row-' + @unit.UnitId,
                                    message: 'هل أنت متأكد من حذف هذه الوحدة؟',
                                    toastMessage: 'تم حذف الوحدة بنجاح.',
                                    btnClass: 'btn-danger',
                                    btnText: ' تأكيد الحذف',
                                    method: 'POST'
                                })">
                            حذف
                        </button>
                        <a type="button" class="btn btn-info" asp-action="Edit" asp-route-id="@unit.UnitId" style="text-decoration: none;">تعديل</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_ConfirmDialogPartial"></partial>