@model IEnumerable<Subject>

@{
    ViewData["Title"] = "المواد";
}

<h1>المواد</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">إضافة مادة جديدة</a>
</p>

<table class="table table-striped table-hover align-middle text-center table-bordered">
    <thead>
        <tr>
            <th>المدة الكلية</th>
            <th>المعلم</th>
            <th>الخطة الدراسية</th>
            <th>اسم المادة</th>
            <th>الوصف</th>
            <th>الصورة</th>
            <th>الخيارات</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.TotalDuration</td>
            <td>@item.Teacher?.UserName</td>
            <td>@item.StudyPlan?.Name</td>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>
                <img src="@item.ImagePath" alt="صورة المادة" class="thumbnail" style="width:120px; height:100px;" />
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SubjectId" class="btn btn-sm btn-warning">تعديل</a>
                <a asp-action="Delete" asp-route-id="@item.SubjectId" class="btn btn-sm btn-danger">حذف</a>
            </td>
        </tr>
}
    </tbody>
</table>
