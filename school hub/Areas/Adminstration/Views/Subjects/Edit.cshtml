@model school_hub.Areas.Adminstration.ViewModels.InputSubjectViewModel

@{
    ViewData["Title"] = "تعديل المادة";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
  
    <input type="hidden" asp-for="ExistingImagePath" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label fw-bold"></label>
        <input asp-for="Name" class="form-control" placeholder="أدخل اسم المادة" required />
        <div class="invalid-feedback">
            الرجاء إدخال اسم المادة.
        </div>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label fw-bold"></label>
        <textarea asp-for="Description" class="form-control" rows="4" placeholder="وصف المادة"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TotalDuration" class="form-label fw-bold"></label>
        <input asp-for="TotalDuration" type="number" min="0" class="form-control" placeholder="مدة المادة بالدقائق" required />
        <div class="invalid-feedback">
            الرجاء إدخال مدة المادة بشكل صحيح.
        </div>
        <span asp-validation-for="TotalDuration" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StudyPlanId" class="form-label fw-bold"></label>
        <select asp-for="StudyPlanId" class="form-select" asp-items="Model.StudyPlans" required>
            <option value="">اختر خطة دراسية</option>
        </select>
        <div class="invalid-feedback">
            الرجاء اختيار خطة دراسية.
        </div>
        <span asp-validation-for="StudyPlanId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TeacherId" class="form-label fw-bold"></label>
        <select asp-for="TeacherId" class="form-select" asp-items="Model.Teacher" required>
            <option value="">اختر المدرس</option>
        </select>
        <div class="invalid-feedback">
            الرجاء اختيار مدرس.
        </div>
        <span asp-validation-for="TeacherId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">الصورة الحالية</label><br />
        @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
        {
            <img id="currentImage" src="@Model.ExistingImagePath" alt="الصورة الحالية" class="img-thumbnail" style="max-width: 250px;" />
        }
        else
        {
            <div class="text-muted">لا توجد صورة حالياً</div>
        }
    </div>

    <div class="mb-3">
        <label asp-for="File" class="form-label fw-bold">رفع صورة جديدة</label>
        <input asp-for="File" type="file" class="form-control" accept="image/*" onchange="previewImage(event)" />
        <span asp-validation-for="File" class="text-danger"></span>
        <div class="mt-3">
            <img id="imagePreview" src="#" alt="معاينة الصورة" class="img-thumbnail" style="display:none; max-width: 250px;" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary me-2">حفظ</button>
    <a asp-action="Index" class="btn btn-secondary">عودة</a>
</form>

@section Scripts {
    <script>
        // Bootstrap validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })();

        // معاينة الصورة قبل الرفع
        function previewImage(event) {
            var input = event.target;
            var preview = document.getElementById('imagePreview');
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.setAttribute('src', e.target.result);
                    preview.style.display = 'block';
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.style.display = 'none';
            }
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
