@{
    ViewData["Title"] = "إدارة المستخدمين";
}

<h2 class="text-center mb-4">إدارة المستخدمين</h2>

<div class="d-flex justify-content-around mb-5">
    <div class="text-center">
        <img src= "~/images-icons/12295982_student_school_avatar_boy_graduate_icon.svg" alt="مشرف" style="width:120px;cursor:pointer;" id="adminImg" />
        <p class="mt-2">المشرف</p>
    </div>
    <div class="text-center">
        <img src="~/images-icons/6570719_class_education_learning_lecture_room_icon.svg" alt="معلم" style="width:120px;cursor:pointer;" id="teacherImg" />
        <p class="mt-2">المعلم</p>
    </div>
    <div class="text-center">
       
        <img src="~/images-icons/4763259_chair_desk_pupil_school_student_icon.svg" alt="طالب" style="width:120px;cursor:pointer;" id="studentImg" />
        <p class="mt-2">الطالب</p>
    </div>
</div>

<div id="tableContainer" class="container">
    <!-- سيتم هنا تحميل جدول المستخدمين -->
</div>

@section Scripts {
    <script>
        document.getElementById('adminImg').addEventListener('click', () => loadTable('Admin'));
        document.getElementById('teacherImg').addEventListener('click', () => loadTable('Teacher'));
        document.getElementById('studentImg').addEventListener('click', () => loadTable('Student'));

        function loadTable(userType) {
            fetch(`/Adminstration/Users/LoadUsersTable?userType=${userType}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('tableContainer').innerHTML = html;
                });
        }
    </script>
}
