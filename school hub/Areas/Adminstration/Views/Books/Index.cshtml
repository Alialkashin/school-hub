@model IEnumerable<school_hub.Models.Book>

@{
    ViewData["Title"] = "قائمة الكتب";
}

<form id="antiForgeryForm" asp-controller="Books" asp-action="Index" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary"><i class="bi bi-book-half"></i>@ViewData["Title"]</h2>
        <a class="btn btn-success" asp-action="Create"><i class="bi bi-plus-circle"></i> إضافة الكتب جديدة</a>
    </div>
</div>
<div id="alertArea"></div>


<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle text-center table-bordered" >
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.First().LibrarySection.Name)</th>
                <th>@Html.DisplayNameFor(m => m.First().Title)</th>
                <th>@Html.DisplayNameFor(m => m.First().Description)</th>
                <th>@Html.DisplayNameFor(m => m.First().BookPath)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.LibrarySection?.Name</td>
                    <td>@book.Title</td>
                    <td>@book.Description</td>
                    <td>
                        <a href="@book.BookPath" target="_blank">
                            <img src="~/images-icons/22179_adobe_file_pdf_icon.png" alt="عرض PDF" style="width:80px; height:auto;" />
                        </a>
                        <div class="text-muted" style="font-size: 0.85rem; margin-top: 5px;">
                            <div><strong>عدد الصفحات:</strong> @book.PageCount</div>
                            <div><strong>تاريخ الرفع:</strong> @book.UploadDate.ToString("yyyy/MM/dd")</div>
                        </div>

                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-primary"
                           style="height:50px; width:50px;" title="تعديل">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-outline-dark"
                           style="height:50px; width:50px;" title="تفاصيل">
                            <i class="bi bi-eye"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete"
                                style="height:50px; width:50px;" title="حذف"
                                data-bookid="@book.BookId" data-booktitle="@book.Title">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">تأكيد حذف الكتاب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                هل أنت متأكد من حذف الكتاب <strong id="bookTitle"></strong>؟
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">حذف</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
               
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function showAlert(message, type = 'success') {
            var alertHtml = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">
                                ${message}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                             </div>`;
            $('#alertArea').html(alertHtml); 
            setTimeout(() => {
                $('#alertArea .alert').alert('close');
            }, 3000);
        }

        $(function () {
            var currentBookId = 0;
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

            $('.btn-delete').click(function () {
                currentBookId = $(this).data('bookid');
                var title = $(this).data('booktitle');
                $('#bookTitle').text(title);
                deleteModal.show();
            });

            $('#confirmDeleteBtn').click(function () {
                $.ajax({
                    url: '@Url.Action("DeleteConfirmed", "Books", new { area = "Adminstration" })',
                    type: 'POST',
                    data: {
                        id: currentBookId,
                        __RequestVerificationToken: $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (result) {
                        if (result === 'done') {
                            $('button[data-bookid="' + currentBookId + '"]').closest('tr').remove();
                            deleteModal.hide();
                            showAlert('تم حذف الكتاب بنجاح', 'success');
                        } else {
                            deleteModal.hide();
                            showAlert('حدث خطأ أثناء الحذف', 'danger');
                        }
                    },
                    error: function () {
                        deleteModal.hide();
                        showAlert('فشل الاتصال بالخادم', 'danger');
                    }
                });
            });
        });
    </script>

}
