@model school_hub.Models.Book

@{
    ViewData["Title"] = "تفاصيل كتاب";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>كتاب</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>

        <dt class="col-sm-2">
            صورة الغلاف
        </dt>
        <dd class="col-sm-10">

            <a href="@Model.BookPath" target="_blank">
                <img src="~/images-icons/22179_adobe_file_pdf_icon.png" alt="عرض PDF" style="width:80px; height:auto;" />
            </a>
        </dd>

        <dt class="col-sm-2">
            عدد الصفحات
        </dt>
        <dd class="col-sm-10">
            @Model.PageCount
        </dd>

        <dt class="col-sm-2">
            تاريخ الرفع
        </dt>
        <dd class="col-sm-10">
            @Model.UploadDate.ToString("yyyy-MM-dd")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LibrarySection)
        </dt>
        <dd class="col-sm-10">
            @Model.LibrarySection?.Name
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.BookId" class="btn btn-primary">تعديل</a> |
    <a asp-action="Index" class="btn btn-secondary">العودة إلى القائمة</a>
</div>
