@model InputBookViewModel

@{
    ViewData["Title"] = "تعديل الكتاب";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingImagePath" />

            <div class="form-group mb-3">
                <label asp-for="LibrarySectionId" class="control-label"></label>
                <select asp-for="LibrarySectionId" class="form-control" asp-items="Model.LibrarySectionItems"></select>
                <span asp-validation-for="LibrarySectionId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            @* عرض رابط ملف PDF الحالي *@
            @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
            {
                <div class="form-group mb-3">
                    <label>الملف الحالي:</label><br />
                    <a href="@Model.ExistingImagePath" target="_blank" class="btn btn-outline-primary">
                            <img src="~/images-icons/22179_adobe_file_pdf_icon.png" alt="عرض PDF" style="width:80px; height:auto;" />
                    </a>
                </div>
            }

            <div class="form-group mb-3">
                <button type="button" class="btn btn-warning" onclick="showFileInput()">تغيير الملف</button>
            </div>

            <div class="form-group mb-3" id="fileInputDiv" style="display:none;">
                <label asp-for="File" class="control-label">اختر ملف PDF جديد</label>
                <input asp-for="File" class="form-control" type="file" accept="application/pdf" />
                <span asp-validation-for="File" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">إلغاء والعودة</a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        <script>
            function showFileInput() {
                document.getElementById('fileInputDiv').style.display = 'block';
            }
        </script> 
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
