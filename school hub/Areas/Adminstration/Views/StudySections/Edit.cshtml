@model InputstudySectionViewModel

@{
    ViewData["Title"] = "تعديل";

}

<h1>تعديل</h1>

<h4>StudySection</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="SectionId" />

            <input type="hidden" asp-for="ExistingImagePath" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
            {
                <div class="form-group" style="margin-bottom:20px">
                    <label>Current Image</label><br />
                    <img src="@Model.ExistingImagePath" class="img-thumbnail" style="width:220px; height:200px" />
                </div>
            }
            <div class="form-group " style="margin-bottom:20px">
                <button type="button" class="btn btn-warning" onclick="showFileInput()">تغيير الصورة</button>
            </div>
            <div class="form-group " id="fileInputDiv" style="display:none; margin-bottom:20px">
                <label asp-for="File" class="control-label">اختر صورة جديدة</label>
                <input asp-for="File" class="form-control" type="file" />
                <span asp-validation-for="File" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="حفظ" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">العودة الى القائمة</a>
</div>

@section Scripts {
   
    <script>
        function showFileInput() {
            document.getElementById('fileInputDiv').style.display = 'block';
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


