@model ExamStartViewModel

@{
  
    ViewData["Title"] = "بدء الاختبار";
}

<div class="container">
    <h3 class="mb-4">اختبار: @Model.ExamTitle</h3>
    <form asp-action="Submit" method="post">
        <input type="hidden" name="ExamId" value="@Model.ExamId" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="mb-4">
                <p><strong>@(i + 1)): @q.Text</strong></p>

                @foreach (var answer in q.Answers)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="Answers[@q.QuestionId]" value="@answer.AnswerId" id="a_@answer.AnswerId" required />
                        <label class="form-check-label" for="a_@answer.AnswerId">
                            @answer.Text
                        </label>
                    </div>
                }
            </div>
        }

        <button type="submit" class="btn btn-success">إرسال الإجابات</button>
    </form>
</div>
