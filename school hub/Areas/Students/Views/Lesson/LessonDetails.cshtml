@model Lesson

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="row">
        <!-- Sidebar -->
        <aside class="col-md-3">
            <div class="list-group" id="videoList">
                <h5 class="mb-3">الفيديوهات</h5>
                @foreach (var video in Model.Videos)
                {
                    <a href="#" 
                       class="list-group-item list-group-item-action video-link" 
                       data-url="@Url.Content(video.VideoPath)">
                        فيديو @video.VideoId
                    </a>
                }

                @if (Model.Exam != null)
                {
                    <hr />
                    <button id="startQuiz" 
                            class="btn btn-primary btn-block mt-2">
                        ابدأ الاختبار
                    </button>
                }
            </div>

            <!-- Rating -->
            <div class="mt-4">
                <h6>تقييم الدرس</h6>
                <div id="rating-stars" class="star-rating mb-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <label class="star">
                            <input type="radio" name="rating" value="@i" />
                            <span class="fa fa-star"></span>
                        </label>
                    }
                </div>
                <button id="submitRating" class="btn btn-success btn-sm">أرسل التقييم</button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="col-md-9">
            <div id="contentArea" class="embed-responsive embed-responsive-16by9">
                <p>اختر فيديو أو ابدأ الاختبار لعرض المحتوى هنا.</p>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // عرض الفيديو
            document.querySelectorAll('.video-link').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const url = this.dataset.url;
                    const area = document.getElementById('contentArea');

                    area.innerHTML = `
                        <video controls class="w-100">
                            <source src="${url}" type="video/mp4">
                            متصفحك لا يدعم عرض الفيديو.
                        </video>`;
                });
            });

            // بدء الاختبار
            const quizBtn = document.getElementById('startQuiz');
            if (quizBtn) {
                quizBtn.addEventListener('click', function () {
                    const lessonId = @Model.LessonId;
                    fetch(`/Quiz/GetByLesson/${lessonId}`)
                        .then(res => res.text())
                        .then(html => {
                            document.getElementById('contentArea').innerHTML = html;
                        });
                });
            }

            // إرسال التقييم
            document.getElementById('submitRating').addEventListener('click', () => {
                const selected = document.querySelector('input[name="rating"]:checked');
                if (!selected) return alert('اختر تقييمًا أولاً');
                const rating = selected.value;
                const lessonId = @Model.LessonId;

                fetch('/Lesson/SubmitRating', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ lessonId, rating })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) alert('تم إرسال التقييم بنجاح');
                });
            });
        });
    </script>
}
