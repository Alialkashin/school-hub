@model List<LessonViewModel>

<div class="container mt-4">
    <h2 class="mb-4">قائمة الدروس</h2>

    @foreach (var lesson in Model)
    {
        <div class="card mb-3 @(lesson.IsUnlocked ? "" : "opacity-50")">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-1">
                        <span class="badge bg-primary">درس @lesson.LessonNo</span> - @lesson.Title
                    </h5>
                    <p class="mb-0">
                        متوسط التقييم:
                        <span class="text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= lesson.AverageRating)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }
                            (@lesson.AverageRating من 5)
                        </span>
                    </p>
                </div>
                <div>
                    @if (lesson.IsUnlocked)
                    {
                        <a href="/Lesson/Details/@lesson.LessonId" class="btn btn-success">دخول الدرس</a>
                    }
                    else
                    {
                        <button class="btn btn-secondary" disabled>مغلق</button>
                    }
                </div>
            </div>
        </div>
    }
</div>
