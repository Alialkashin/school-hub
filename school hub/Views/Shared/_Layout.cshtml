<!DOCTYPE html>
<html lang="en" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - school_hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/school_hub.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/fontawesome-free-6.7.2-web/css/all.min.css" />

</head>
<body>
    <header>
   @*      <a class="navbar-brand d-flex align-items-center" href="/">
    <img src="~/images/logo.png" alt="شعار المنصة" style="height: 40px;" class="me-2" />
    <span class="fw-bold text-primary">منصة تعليمية</span>
</a>        مشان شعار المنصة *@

        <nav class="navbar navbar-expand-lg navbar-custom shadow">
            <div class="container">
                <a class="navbar-brand fw-bold" href="#">منصة تعليمية</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" href="/">الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/StudySections">الأقسام</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Library" asp-action="Sections">مكتبة الموقع</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/About">لمحة عنا</a>
                        </li>
                    </ul>
                    <div class="d-flex">
                        <a asp-action="Register" asp-controller="Account" class="btn btn-outline-primary me-2">إنشاء حساب</a>
                        <a  asp-action="Login" asp-controller="Account" class="btn btn-primary text-white">تسجيل دخول للمنصة</a>
                    </div>
                </div>
            </div>
        </nav>
            <!-- Navbar ينتهي هون -->

            <div class="container">
                @RenderBody()
            </div>
        </header>


    <main role="main" class="flex-grow-1">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="myfooter">
        <div class="container mt-2">
            <div class="row">
                <div class="col-sm-4 col-md-4 col-lg-4 col-xl-4">
                    <h4>تواصل معنا</h4>
                    <p>تابعنا على مواقع التواصل الاجتماعي :</p>
                    <div class="mt-3 mb-2">
                        <a href="#"><img src="~/images-icons/6929237_instagram_icon.svg" style="width:30px; height:30px;" /></a>
                        <span class="fs-6 mx-1"><a href="#"><img src="~/images-icons/6929232_logo_whatsapp_icon.svg" style="width:30px; height:30px;" /></a></span>
                        <span class="fs-6 mx-1"><a href="#"><img src="~/images-icons/4102573_applications_facebook_media_social_icon.svg" style="width:30px; height:30px;" /></a></span>
                        <span class="fs-6 mx-1"><a href="#"><img src="~/images-icons/4375133_logo_youtube_icon.svg" style="width:30px; height:30px;" /></a></span>
                    </div>
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4 col-xl-4">
                    <h4>روابط سريعة</h4>
                    <ul class="list-unstyled row p-2 flex-wrap">
                        <div class="col-6">
                        <li><a class="nav-link active" href="/">الرئيسية</a></li>
                        <li><a class="nav-link" href="/StudySections">الأقسام</a></li>
                </div>
                <div class="col-6">
                    <li><a class="nav-link" asp-controller="Library" asp-action="Sections">مكتبة الموقع</a></li>
                    <li><a class="nav-link" href="/Home/About">لمحة عنا</a></li>
                </div>
                </ul>
            </div>
            <div class="col-sm-4 col-md-4 col-lg-4 col-xl-4">
                <h4>العنوان</h4>
                <p>سوريا، دمشق - شارع التعليم، بناء المنصة</p>
                <p>للتواصل: info@schoolhub.com</p>
            </div>
        </div>
        </div>
        <div class="subfooter">
            <span>&copy; 2025 منصة تعليمية - جميع الحقوق محفوظة</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


 
