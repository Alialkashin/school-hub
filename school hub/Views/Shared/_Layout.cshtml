<!DOCTYPE html>
<html lang="en" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - school_hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/school_hub.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/fontawesome-free-6.7.2-web/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom shadow">
            <div class="container">
                <a class="navbar-brand fw-bold" href="#">منصة تعليمية</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#mainNavbarOffcanvas" aria-controls="mainNavbarOffcanvas">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="offcanvas offcanvas-end text-bg-light" tabindex="-1" id="mainNavbarOffcanvas" aria-labelledby="mainNavbarOffcanvasLabel">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" id="mainNavbarOffcanvasLabel">القائمة</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button>
                    </div>
                    <div class="offcanvas-body" style="max-height: calc(100vh - 100px); overflow-y: auto;">
                        <ul class="navbar-nav mb-2 mb-lg-0">
                            <li class="nav-item"><a class="nav-link active" href="/">الرئيسية</a></li>
                            <li class="nav-item"><a class="nav-link" href="/StudySections">الأقسام</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Library" asp-action="Sections">مكتبة الموقع</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Home/About">لمحة عنا</a></li>
                            <!-- يمكنك إضافة المزيد من العناصر هنا -->
                        </ul>
                        <div class="d-flex mt-3">
                            <a asp-action="Register" asp-controller="Account" class="btn btn-outline-primary me-2">إنشاء حساب</a>
                            <a asp-action="Login" asp-controller="Account" class="btn btn-primary text-white">تسجيل دخول للمنصة</a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <div class="container">
            @RenderBody()
        </div>
    </header>

    <main role="main" class="flex-grow-1">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="myfooter">
        <div class="container mt-2">
            <div class="row">
                <div class="col-sm-4">
                    <h4>تواصل معنا</h4>
                    <p>تابعنا على مواقع التواصل الاجتماعي :</p>
                    <div class="mt-3 mb-2">
                        <a href="#"><img src="~/images-icons/6929237_instagram_icon.svg" style="width:30px; height:30px;" /></a>
                        <span class="fs-6 mx-1"><a href="#"><img src="~/images-icons/6929232_logo_whatsapp_icon.svg" style="width:30px; height:30px;" /></a></span>
                        <span class="fs-6 mx-1"><a href="#"><img src="~/images-icons/4102573_applications_facebook_media_social_icon.svg" style="width:30px; height:30px;" /></a></span>
                        <span class="fs-6 mx-1"><a href="#"><img src="~/images-icons/4375133_logo_youtube_icon.svg" style="width:30px; height:30px;" /></a></span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <h4>روابط سريعة</h4>
                    <ul class="list-unstyled row p-2 flex-wrap">
                        <div class="col-6">
                        <li><a class="nav-link active" href="/">الرئيسية</a></li>
                        <li><a class="nav-link" href="/StudySections">الأقسام</a></li>
                </div>
                <div class="col-6">
                    <li><a class="nav-link" asp-controller="Library" asp-action="Sections">مكتبة الموقع</a></li>
                    <li><a class="nav-link" href="/Home/About">لمحة عنا</a></li>
                </div>
                </ul>
            </div>
            <div class="col-sm-4">
                <h4>العنوان</h4>
                <p>سوريا، دمشق - شارع التعليم، بناء المنصة</p>
                <p>للتواصل: info@schoolhub.com</p>
            </div>
        </div>
        </div>
        <div class="subfooter text-center mt-3">
            <span>&copy; 2025 منصة تعليمية - جميع الحقوق محفوظة</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
