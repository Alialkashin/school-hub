<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة الأستاذ</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/school_hub.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/fontawesome-free-6.7.2-web/css/all.min.css" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar d-flex flex-column">
            <div class="sidebar-header text-center">
                <h4><i class="fas fa-chalkboard-teacher me-2"></i>لوحة الأستاذ</h4>
            </div>
            <ul class="nav flex-column p-3">
                <li class="nav-item mb-2">
                    <a class="nav-link" asp-area="Teacher" asp-controller="Subjects" asp-action="index">
                        <i class="fas fa-book-open me-2 text-info"></i>موادي الدراسية
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link" asp-area="Teacher" asp-controller="Units" asp-action="index">
                        <i class="fas fa-user-graduate me-2 text-primary"></i>الوحدات الدراسية
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link" asp-area="" asp-controller="Profile" asp-action="Index">
                        <i class="fas fa-user-circle me-2 text-success"></i>حسابي
                    </a>
                </li>
                    <li class="nav-item mt-4">
                        <a class="nav-link" onclick="showLogOutDialog()">
                            <i class="fas fa-sign-out-alt me-2 text-danger"></i>تسجيل الخروج
                        </a>
                    </li>
                <partial name="_LogOutPartial"></partial>
                </ul>
        </nav>

        <!-- Main Content -->
        <div class="main-content w-100">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
