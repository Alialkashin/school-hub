@model List<LibrarySection>

<div class="container mt-4">
    <h2 class="text-center mb-4">أقسام المكتبة</h2>
    <div class="row">
        @foreach (var p in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm section-card" style="cursor:pointer;" data-sectionid="@p.SectionId">
                    <img src="@p.ImagePath" class="card-img-top" alt="صورة القسم" />
                    <div class="card-body">
                        <h5 class="card-title">@p.Name</h5>
                        <p class="card-text">@p.Description</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.section-card').forEach(card => {
            card.addEventListener('click', function () {
                const id = this.getAttribute('data-sectionid');
                window.location.href = '/Library/GetSectionBooks/' + id;
            });
        });
    </script>
}
