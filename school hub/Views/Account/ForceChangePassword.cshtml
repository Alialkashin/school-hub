@model ChangePasswordViewModel
@{
    ViewData["Title"] = "اعادة تعيين كلمة المرور";
}


<div class="container mt-5">
        <h1 class="text-center text-dark">@ViewData["Title"]</h1>
        <div class="row justify-content-center">
            <div class="col-md-6">
                <section class="bg-light p-5 rounded shadow-lg">
                     <h2 class="text-danger">يجب اعادة تعيين كلمة المرور اجباريا بعد أول تسجيل دخول</h2>
                     <form asp-action="ForceChangePassword" method="post" class="form form-group">
                         <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                   
                         <div class="form-group">
                             <label asp-for="NewPassword"></label>
                             <input asp-for="NewPassword" class="form-control" />
                             <span asp-validation-for="NewPassword"></span>
                         </div>
                         <div class="form-group">
                             <label asp-for="ConfirmPassword"></label>
                             <input asp-for="ConfirmPassword" class="form-control" />
                             <span asp-validation-for="ConfirmPassword"></span>
                         </div>
                         <button type="submit" class="btn btn-primary">تحديث كلمة المرور</button>
                     </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}